# Public browser values only. These are protected by Supabase RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional: only for local testing of phone notifications before send-push is
# deployed. The deployed app asks the function for the public key instead
# (see scripts/generate-vapid-keys.mjs). Never put the private key here.
VITE_VAPID_PUBLIC_KEY=the-public-key-from-npm-run-vapid-keys
