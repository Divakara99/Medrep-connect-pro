<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!--
          Android 15+ draws the app edge-to-edge. MainActivity pads the content
          view by the system-bar insets; these two attributes only control the
          colour of the icons on the white background behind them, so the clock
          and battery stay legible instead of white-on-white.
        -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>


    <!--
      The launch theme MUST hand over to a NoActionBar theme. Without this the
      activity keeps Theme.SplashScreen after the splash finishes, and
      AppCompatActivity falls back to decorating the window with the app's own
      label as a title bar — the strip reading "MedRep Pro" that appeared above
      the web header.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>