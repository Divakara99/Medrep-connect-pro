<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!--
          Android 15+ draws the app edge-to-edge. MainActivity pads the content
          view by the system-bar insets; these two attributes only control the
          colour of the icons on the white background behind them, so the clock
          and battery stay legible instead of white-on-white.
        -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>


    <!--
      The launch theme was the last place a title bar could come from. It painted
      the app label ("MedRep Pro") on top of `android:background`, which was the
      splash drawable — that is why the strip above the web header was filled
      with splash artwork. It now forbids a title bar outright, uses the standard
      Android 12+ splash (brand icon on white, back-ported by core-splashscreen
      to API 24) and hands over to the NoActionBar theme.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>