{
  "name": "medrep-connect-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "vapid:keys": "node scripts/generate-vapid-keys.mjs",
    "db:list": "node scripts/copy-sql.mjs list",
    "db:copy": "node scripts/copy-sql.mjs copy",
    "lint": "oxlint",
    "test:security": "node scripts/test-secure-jobs.mjs",
    "test:billing": "node scripts/test-billing-plans.mjs",
    "test:resumes": "node scripts/test-resumes.mjs",
    "test:applications": "node scripts/test-applications.mjs",
    "test:descriptions": "node scripts/test-description-guard.mjs",
    "test:support": "node scripts/test-support-requests.mjs",
    "test:refund-check": "node scripts/test-refund-check.mjs",
    "test:vacancy-team": "node scripts/test-vacancy-team.mjs",
    "test:vacancy-rules": "node scripts/test-vacancy-rules.mjs",
    "test": "npm run test:security && npm run test:billing && npm run test:resumes && npm run test:applications && npm run test:descriptions && npm run test:support && npm run test:refund-check && npm run test:vacancy-team && npm run test:vacancy-rules && npm run test:push",
    "preview": "vite preview",
    "test:push": "node scripts/test-push-rules.mjs && node scripts/test-admin-access-rules.mjs && node scripts/test-webpush-crypto.mjs && node scripts/test-send-push-function.mjs && node scripts/test-admin-mfa-toggle.mjs && node scripts/test-push-subscriptions.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
